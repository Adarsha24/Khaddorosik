generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  phone        String?
  address      String?
  city         String?
  pincode      String?
  logo         String?
  gstNumber    String?           @map("gst_number")
  fssaiNumber  String?           @map("fssai_number")
  taxRate      Decimal           @default(0.05) @map("tax_rate") @db.Decimal(5, 4)
  cgstRate     Decimal           @default(0.025) @map("cgst_rate") @db.Decimal(5, 4)
  sgstRate     Decimal           @default(0.025) @map("sgst_rate") @db.Decimal(5, 4)
  currency     String            @default("INR")
  timezone     String            @default("Asia/Kolkata")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  categories   Category[]
  customers    Customer[]
  discounts    Discount[]
  employees    Employee[]
  inventory    InventoryItem[]
  orders       Order[]
  reservations Reservation[]
  tables       RestaurantTable[]
  shifts       Shift[]
  suppliers    Supplier[]
  users        User[]

  @@map("restaurants")
}

model User {
  id                 String         @id @default(uuid())
  restaurantId       String         @map("restaurant_id")
  email              String         @unique
  passwordHash       String         @map("password_hash")
  mustChangePassword Boolean        @default(true) @map("must_change_password")
  role               Role           @default(WAITER)
  employeeId         String?        @unique @map("employee_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  orders             Order[]        @relation("CreatedBy")
  refreshTokens      RefreshToken[]
  employee           Employee?      @relation(fields: [employeeId], references: [id])
  restaurant         Restaurant     @relation(fields: [restaurantId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otp_codes")
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  name         String
  displayOrder Int        @default(0) @map("display_order")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@map("categories")
}

model MenuItem {
  id          String      @id @default(uuid())
  categoryId  String      @map("category_id")
  name        String
  price       Decimal     @db.Decimal(10, 2)
  costPrice   Decimal     @default(0) @map("cost_price") @db.Decimal(10, 2)
  veg         Boolean     @default(false)
  description String?
  imageUrl    String?     @map("image_url")
  available   Boolean     @default(true)
  bestSeller  Boolean     @default(false) @map("best_seller")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  @@unique([categoryId, name])   // ← ADD THIS LINE
  @@map("menu_items")
}

model RestaurantTable {
  id            String         @id @default(uuid())
  restaurantId  String         @map("restaurant_id")
  number        Int
  capacity      Int
  section       String?
  status        TableStatus    @default(AVAILABLE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  reservations  Reservation[]
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  tableSessions TableSession[]

  @@unique([restaurantId, number])
  @@map("restaurant_tables")
}

model TableSession {
  id       String          @id @default(uuid())
  tableId  String          @map("table_id")
  waiterId String?         @map("waiter_id")
  openedAt DateTime        @default(now()) @map("opened_at")
  closedAt DateTime?       @map("closed_at")
  status   SessionStatus   @default(OPEN)
  orders   Order[]
  table    RestaurantTable @relation(fields: [tableId], references: [id])

  @@map("table_sessions")
}

model Order {
  id             String        @id @default(uuid())
  restaurantId   String        @map("restaurant_id")
  billNo         Int?          @map("bill_no")
  tableSessionId String?       @map("table_session_id")
  tableId        String?       @map("table_id")
  customerId     String?       @map("customer_id")
  orderType      OrderType     @default(DINE_IN) @map("order_type")
  status         OrderStatus   @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  cgstAmount     Decimal       @default(0) @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount     Decimal       @default(0) @map("sgst_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountCode   String?       @map("discount_code")
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  kots           KOT[]
  items          OrderItem[]
  creator        User?         @relation("CreatedBy", fields: [createdBy], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id])
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  payments       Payment[]

  @@map("orders")
}

model OrderItem {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  menuItemId String     @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal    @map("unit_price") @db.Decimal(10, 2)
  notes      String?
  status     ItemStatus @default(PENDING)
  createdAt  DateTime   @default(now()) @map("created_at")
  kotItems   KOTItem[]
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model KOT {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  tableId     String?   @map("table_id")
  status      KOTStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  kotItems    KOTItem[]
  order       Order     @relation(fields: [orderId], references: [id])

  @@map("kots")
}

model KOTItem {
  id          String    @id @default(uuid())
  kotId       String    @map("kot_id")
  orderItemId String    @map("order_item_id")
  quantity    Int
  done        Boolean   @default(false)
  kot         KOT       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("kot_items")
}

model Payment {
  id        String         @id @default(uuid())
  orderId   String         @map("order_id")
  amount    Decimal        @db.Decimal(10, 2)
  tipAmount Decimal        @default(0) @db.Decimal(10, 2) @map("tip_amount")
  method    PaymentMethod
  reference String?
  status    PaymentStatus  @default(COMPLETED)
  createdAt DateTime       @default(now()) @map("created_at")
  splits    PaymentSplit[]
  order     Order          @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model PaymentSplit {
  id        String        @id @default(uuid())
  paymentId String        @map("payment_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_splits")
}

model Reservation {
  id           String            @id @default(uuid())
  restaurantId String            @map("restaurant_id")
  customerId   String?           @map("customer_id")
  tableId      String?           @map("table_id")
  date         DateTime          @db.Date
  time         String
  partySize    Int               @map("party_size")
  status       ReservationStatus @default(PENDING)
  notes        String?
  guestName    String            @map("guest_name")
  guestPhone   String?           @map("guest_phone")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  customer     Customer?         @relation(fields: [customerId], references: [id])
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  table        RestaurantTable?  @relation(fields: [tableId], references: [id])

  @@map("reservations")
}

model InventoryItem {
  id           String                 @id @default(uuid())
  restaurantId String                 @map("restaurant_id")
  supplierId   String?                @map("supplier_id")
  name         String
  category     String
  unit         String
  currentStock Decimal                @map("current_stock") @db.Decimal(10, 3)
  reorderLevel Decimal                @map("reorder_level") @db.Decimal(10, 3)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id])
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  transactions InventoryTransaction[]
  @@unique([restaurantId, name])   // ← ADD THIS LINE
  @@map("inventory_items")
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  itemId      String          @map("item_id")
  quantity    Decimal         @db.Decimal(10, 3)
  type        TransactionType
  referenceId String?         @map("reference_id")
  notes       String?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  item        InventoryItem   @relation(fields: [itemId], references: [id])

  @@map("inventory_transactions")
}

model Supplier {
  id           String          @id @default(uuid())
  restaurantId String          @map("restaurant_id")
  name         String
  contactName  String?         @map("contact_name")
  email        String?
  phone        String?
  address      String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  inventory    InventoryItem[]
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])

  @@map("suppliers")
}

model Employee {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  name         String
  role         EmployeeRole
  phone        String?
  email        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  joiningDate  DateTime?    @map("joining_date")
  salary       Decimal      @db.Decimal(10, 2)
  payrolls     Payroll[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  user         User?

  @@map("employees")
}

model Customer {
  id            String        @id @default(uuid())
  restaurantId  String        @map("restaurant_id")
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int           @default(0) @map("loyalty_points")
  totalVisits   Int           @default(0) @map("total_visits")
  totalSpent    Decimal       @default(0) @map("total_spent") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  orders        Order[]
  reservations  Reservation[]

  @@unique([restaurantId, phone])
  @@map("customers")
}

model Discount {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  code         String
  description  String?
  type         DiscountType @default(FLAT)
  value        Decimal      @db.Decimal(10, 2)
  minOrder     Decimal      @default(0) @map("min_order") @db.Decimal(10, 2)
  maxUses      Int?         @map("max_uses")
  usedCount    Int          @default(0) @map("used_count")
  active       Boolean      @default(true)
  expiresAt    DateTime?    @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code])
  @@map("discounts")
}

model Shift {
  id           String      @id @default(uuid())
  restaurantId String      @map("restaurant_id")
  openedById   String?     @map("opened_by_id")
  closedById   String?     @map("closed_by_id")
  openingCash  Decimal     @default(0) @map("opening_cash") @db.Decimal(10, 2)
  closingCash  Decimal?    @map("closing_cash") @db.Decimal(10, 2)
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now()) @map("opened_at")
  closedAt     DateTime?   @map("closed_at")
  notes        String?
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])

  @@map("shifts")
}

model Payroll {
  id          String        @id @default(uuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal       @db.Decimal(10, 2)   // was: Float
  bonus       Decimal       @default(0) @db.Decimal(10, 2)   // was: Float
  deduction   Decimal       @default(0) @db.Decimal(10, 2)   // was: Float
  netSalary   Decimal       @db.Decimal(10, 2)   // was: Float
  status      PayrollStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum KOTStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  SPLIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
  WASTE
}

enum EmployeeRole {
  MANAGER
  HEAD_WAITER
  WAITER
  CASHIER
  KITCHEN_STAFF
  CHEF
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PayrollStatus {
  PENDING
  PAID
}
